# Copia este archivo a .env (nunca se sube al repo) y completa los valores.
# En Azure, REGISTRO_API_KEY y DATABASE_URL vienen de Key Vault (no se escriben aquí).

# Clave que deben enviar los clientes en el header x-api-key (local: inventa una de prueba)
REGISTRO_API_KEY=

# Vacía = SQLite en api_registro/datos_local/registro.db
# Postgres: postgresql://USUARIO:CLAVE@HOST:5432/registro?sslmode=require
DATABASE_URL=

# Opcionales
ZONA_HORARIA=America/Santiago
NIVEL_LOG=INFO
HABILITAR_DOCS=false
MAX_BYTES_CUERPO=16384
MAX_RESULTADOS=5000
