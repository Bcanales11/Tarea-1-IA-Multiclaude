# Copiar a .env (nunca subir .env al repo).
# Servicio de agentes: local (uvicorn servidor:app --port 8080 en ../agentes) o la URL de Cloud Run.
AGENTES_URL=http://localhost:8080
# Debe ser igual a AGENTES_API_KEY del servicio de agentes.
AGENTES_API_KEY=
KIOSCO_ID=colegio-001
AGENTES_TIMEOUT_S=90

# --- Cloud Run privado (opción a del README, "Acceso a Cloud Run") ---------------------------
# Vacío = no se manda identidad de Google (agentes locales o servicio público).
# Con valor = la URL del servicio de Cloud Run; la app manda un ID token de Google además de la clave.
AGENTES_AUDIENCIA_IAM=
# Ruta al archivo de clave de la cuenta de servicio kiosco-app-invoker (FUERA del repo).
# Requiere: pip install google-auth. Se deja comentada: vacía, google-auth la tomaría como ruta.
# GOOGLE_APPLICATION_CREDENTIALS=
