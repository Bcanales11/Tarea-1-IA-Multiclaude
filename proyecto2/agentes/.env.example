# Copia este archivo como .env (en esta misma carpeta) y completa los valores.
# .env NUNCA se sube al repo. En Cloud Run, los secretos vienen de Azure Key Vault.

# --- Modelos ---------------------------------------------------------------
# Respaldo (Google). Clave en https://aistudio.google.com/apikey
GEMINI_API_KEY=
MODELO_RESPALDO=gemini/gemini-3.5-flash
# Principal (Azure AI Foundry). Vacío = se usa el respaldo como principal.
# Formato: azure/<nombre-del-deployment>   (lo pasa Benjamín)
MODELO_PRINCIPAL=
AZURE_API_BASE=
AZURE_API_KEY=
AZURE_API_VERSION=
# Modelo de los especialistas (niveles 2 y 3). Vacío = el mismo del orquestador.
MODELO_ESPECIALISTAS=gemini/gemini-3.5-flash-lite
TIMEOUT_MODELO_S=30
REINTENTOS_MODELO=2

# --- Knowledge bases ---------------------------------------------------------
# local = búsqueda propia sobre proyecto2/knowledge ; foundry = Azure AI Foundry
KB_BACKEND=local
KB_NORMATIVA=kb-normativa
KB_CATALOGO=kb-catalogo
FOUNDRY_SEARCH_ENDPOINT=
FOUNDRY_SEARCH_API_KEY=
FOUNDRY_KB_API_VERSION=

# --- Registro de chequeos (API de Benjamín) -------------------------------------
# local = SQLite en datos_local/ ; api = API de registro en Azure
REGISTRO_BACKEND=local
REGISTRO_API_URL=
REGISTRO_API_KEY=
KIOSCO_ID_DEFECTO=colegio-001

# --- Servidor (Cloud Run) ---------------------------------------------------------
# Clave que la app Flask manda en el header x-api-key a /consulta
AGENTES_API_KEY=

# --- Key Vault (Magíster) -----------------------------------------------------------
# Si se define, las claves se leen de Key Vault (ver kiosco_agentes/secretos.py)
KEY_VAULT_URL=

# --- Logs ---------------------------------------------------------------------------
NIVEL_LOG=INFO
ARCHIVO_LOG=
