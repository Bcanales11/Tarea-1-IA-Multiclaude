# macOS
.DS_Store

# Python
__pycache__/
*.pyc
*.pyo

# Fotos (pesan mucho, GB — se juntan/comparten localmente, ver vision/README.md). Las
# etiquetas (.txt) SÍ se suben, solo las imágenes quedan afuera.
vision/dataset/images_sin_etiquetar/*
vision/dataset/etiquetadas/images/
vision/dataset/images/train/*
vision/dataset/images/val/*

# Fotos crudas del Jumbo (rar suelto en la raíz) y lotes armados para repartir por zip
/Fotos/
vision/dataset/lotes_para_repartir/

# Export de Roboflow (son las fotos + labels sin convertir; ya procesado y subido vía
# vision/importar_roboflow.py, el resultado queda en vision/dataset/images y labels)
/*.v*i.yolov8/
/*.v*i.yolov8.zip
/*.v*i.yolov8.tar

# Cache que genera Ultralytics al entrenar (binario, se regenera solo)
vision/dataset/labels/*.cache

# Entorno virtual de Python (cada uno arma el suyo, ver vision/README.md)
vision/.venv/

# Historial local de escaneos de la app (dato generado en cada máquina, no código)
app/historial.db
